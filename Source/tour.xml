  <plugin name="soundinterface" keep="true" url="%FIRSTXML%/plugins/soundinterface.js" />

  <action name="controls_lock">
    set(control.usercontrol, off);
		set(control.mouse, off);
		set(control.touch, off);
  </action>

  <action name="controls_unlock">
    set(control.usercontrol, all);
		set(control.mouse, drag);
		set(control.touch, drag);
  </action>

  <action name="show_start_screen">
    trace(asdfasdf);
    set(layer[start_screen].visible, true);
  	controls_lock();
  </action>

  <action name="hide_start_screen">
    trace(hide_start_screen);
    set(layer[start_screen].visible, false);
		set(layer[start_screen].enabled, false);
		set(layer[start_screen].capture, false);
		set(layer[start_screen].handcursor, false);

  	controls_unlock();
		if(is_hmd,
			trace("is HMD");
			webvr_enter();,
			trace("is not HMD");
		);

		if(can_vr,
			trace("can HMD");
			webvr_enter();,
			trace("can not HMD");
		);
    <!-- disable_scene(scene_01_0002); -->
  </action>

  <action
    name="init_xr_flags"
    type="Javascript"
  ><![CDATA[
		(function(){
			var krp = krpano; // krpano JS 인터페이스

			function setFlag(isHMD){
				krp.set("device.is_hmd", isHMD ? "true" : "false");
				// 필요하면 분기 액션 호출
				// krp.call(isHMD ? "on_hmd();" : "on_pc();");
			}

			// 기본값: HMD 아님
			setFlag(false);

			// WebXR 지원이 없으면 끝
			if (!navigator.xr) return;

			// XR 세션의 시작/종료를 후킹해서 "현재 HMD 모드인지"를 추적
			var _requestSession = navigator.xr.requestSession && navigator.xr.requestSession.bind(navigator.xr);
			if (_requestSession) {
				navigator.xr.requestSession = function(mode, opts){
					return _requestSession(mode, opts).then(function(session){
						if (mode === "immersive-vr") setFlag(true);

						session.addEventListener("end", function(){
							setFlag(false);
						});

						return session;
					});
				};
			}

			// (추가) 이미 immersive-vr 가능 여부도 같이 저장해두고 싶다면:
			if (navigator.xr.isSessionSupported) {
				navigator.xr.isSessionSupported("immersive-vr").then(function(ok){
					krp.set("device.can_vr", ok ? "true" : "false");
				});
			}
		})();
		]]>
	</action>

